{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{api/_lib/**,api_client.py,auth.py,changelog.md,new_changes.md,feedback.txt}"
    }
  },

  "redirects": [
    { "source": "/", "destination": "/index.html", "permanent": false }
  ],

  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__route=$1" }
  ],

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
